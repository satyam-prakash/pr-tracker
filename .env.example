# ============================================================
# PR Tracker — Environment Variables Template
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ============================================================

# ── Auth Service ─────────────────────────────────────────────
MONGO_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
JWT_SECRET=
ENCRYPTION_SECRET=
CLIENT_URL=http://localhost:5173

# ── Main Backend ─────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
WEBHOOK_URL=

# ── Vite Frontend (baked in at build time) ───────────────────
VITE_SERVER_ENDPOINT=http://localhost

# ── AI Agent ─────────────────────────────────────────────────
MISTRAL_API_KEY=

# ── Poller Worker ────────────────────────────────────────────
# Shared secret — gateway validates this header from the poller
POLLER_SECRET=

# ── Monitoring ───────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# ── Deployment ───────────────────────────────────────────────
# EC2 host / SSH credentials (used by GitHub Actions only)
VPS_HOST=
VPS_USER=ubuntu
# VPS_SSH_KEY — store in GitHub Secrets, never here
