.env
.env.*
!.env.example

# Node
node_modules/

# Build outputs
dist/
build/
.next/

# OS / Editor
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/

# Docker
*.log

# Temporary files
*.tmp
